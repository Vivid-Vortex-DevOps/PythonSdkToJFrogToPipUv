# Copy to .env and fill in values.
# For local Docker Artifactory use the defaults below.
# For JFrog Cloud, replace with your instance URL.

JFROG_BASE_URL=http://localhost:8082

# PyPI upload endpoint (no trailing slash needed for twine)
JFROG_PYPI_URL=http://localhost:8082/artifactory/api/pypi/pypi-local/

# PyPI simple index (used by pip / uv to install)
JFROG_PYPI_SIMPLE_URL=http://localhost:8082/artifactory/api/pypi/pypi-local/simple/

JFROG_USERNAME=admin
JFROG_PASSWORD=password
